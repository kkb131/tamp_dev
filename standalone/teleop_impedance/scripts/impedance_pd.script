# torque_relay.script
# Torque relay for UR10e impedance control
# Reads pre-computed torques from RTDE input registers and applies them
# via direct_torque(). PD computation happens Python-side.
#
# Register allocation (written by Python via RTDEIOInterface, lower range):
#   Double 18..22: tau[0..4]      (joint torques, Nm)
#   Int 18:        tau[5] * 1000  (wrist3 millitorque, int32)
#   Int 19:        mode           (0=idle, 1=active, -1=stop)
#
# Gravity compensation is handled automatically by direct_torque().
# Friction compensation is enabled by default.

def torque_relay():
  textmsg("TorqueRelay: Starting controller")

  # UR10e torque limits [Nm] per joint (safety saturation)
  local max_tau = [150.0, 150.0, 56.0, 56.0, 28.0, 28.0]
  local prev_mode = 0

  while True:
    # Read mode flag from Python (integer register 19)
    local mode = read_input_integer_register(19)

    # Log mode transitions (not every loop)
    if mode != prev_mode:
      textmsg(str_cat(str_cat(str_cat("TorqueRelay: mode ", to_str(prev_mode)), " -> "), to_str(mode)))
      prev_mode = mode
    end

    if mode < 0:
      # Stop command from Python
      textmsg("TorqueRelay: Stop requested")
      break
    end

    if mode > 0:
      # Active mode: read torques from registers and apply

      local tau = [read_input_float_register(18),
                    read_input_float_register(19),
                    read_input_float_register(20),
                    read_input_float_register(21),
                    read_input_float_register(22),
                    to_num(read_input_integer_register(18)) / 1000.0]

      # Torque saturation (safety layer in URScript)
      local idx = 0
      while idx < 6:
        if tau[idx] > max_tau[idx]:
          tau[idx] = max_tau[idx]
        elif tau[idx] < -max_tau[idx]:
          tau[idx] = -max_tau[idx]
        end
        idx = idx + 1
      end

      # Apply torque (gravity auto-compensated, friction comp enabled)
      direct_torque(tau, friction_comp=True)

    else:
      # Idle mode: maintain timestep without torque command
      sync()
    end
  end

  textmsg("TorqueRelay: Stopping")
  stopj(4.0)
  textmsg("TorqueRelay: Controller stopped")
end

torque_relay()
